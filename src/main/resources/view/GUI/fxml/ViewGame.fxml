<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" prefHeight="720.0" prefWidth="1280.0"
           stylesheets="@../css/ViewGame_style.css" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.ingsw.am56.view.GUI.controllers.ViewGameController">

    <ImageView fitWidth="${rootPane.width}" fitHeight="${rootPane.height}" preserveRatio="false">
        <Image url="@../images/background_empty2.png" />
    </ImageView>

    <ScrollPane fitToWidth="true" styleClass="transparent-scroll">

        <StackPane>

            <VBox alignment="TOP_CENTER">
                <VBox fx:id="mainBoardArea" alignment="CENTER" spacing="20">
                    <padding>
                        <Insets top="20" bottom="20"/>
                    </padding>

                    <HBox alignment="CENTER" spacing="30">
                        <HBox fx:id="upperBuildingsBox" spacing="10" alignment="CENTER" styleClass="card-row-background" maxWidth="-Infinity" />
                        <HBox fx:id="upperTribeBox" spacing="10" alignment="CENTER" styleClass="card-row-background" maxWidth="-Infinity" />
                    </HBox>

                    <HBox fx:id="centerTilesBox" alignment="CENTER">
                        <padding>
                            <Insets top="40" bottom="40"/>
                        </padding>
                    </HBox>

                    <HBox alignment="CENTER" spacing="30">
                        <HBox fx:id="lowerBuildingsBox" spacing="10" alignment="CENTER" styleClass="card-row-background" maxWidth="-Infinity" />
                        <HBox fx:id="lowerTribeBox" spacing="10" alignment="CENTER" styleClass="card-row-background" maxWidth="-Infinity" />
                    </HBox>
                </VBox>

                <HBox fx:id="playersStatsContainer" alignment="CENTER" spacing="30">
                    <padding>
                        <Insets top="40" bottom="80"/>
                    </padding>
                </HBox>
            </VBox>

            <VBox fx:id="gameInfoBox" styleClass="game-info-box" visible="false"
                  StackPane.alignment="TOP_LEFT" maxWidth="-Infinity" maxHeight="-Infinity">
                <StackPane.margin>
                    <Insets top="20" left="20"/>
                </StackPane.margin>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="ERA:" styleClass="info-title"/>
                    <Label fx:id="currentEraLabel" text="-" styleClass="info-value"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="ROUND:" styleClass="info-title"/>
                    <Label fx:id="currentRoundLabel" text="-" styleClass="info-value"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                    <Label text="TURN OF:" styleClass="info-title"/>
                    <Label fx:id="currentPlayerLabel" styleClass="info-value-player"/>
                </HBox>
            </VBox>

            <VBox fx:id="quickStatsBox" visible="false" alignment="TOP_CENTER" spacing="10"
                  StackPane.alignment="TOP_RIGHT" maxWidth="-Infinity" maxHeight="-Infinity"
                  style="-fx-padding: 15; -fx-background-color: rgba(255, 255, 255, 0.85); -fx-background-radius: 10; -fx-border-color: #333333; -fx-border-radius: 10; -fx-border-width: 2; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.6), 10, 0, 0, 5);">
                <StackPane.margin>
                    <Insets top="20" right="20"/>
                </StackPane.margin>

                <Label text="LE TUE RISORSE" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #333333;" wrapText="true" textAlignment="CENTER"/>
            </VBox>

        </StackPane>
    </ScrollPane>

    <VBox fx:id="customTooltip" styleClass="custom-tooltip" mouseTransparent="true" opacity="0" StackPane.alignment="TOP_LEFT" maxWidth="250" maxHeight="-Infinity">
        <Label fx:id="tooltipTextLabel" wrapText="true" styleClass="tooltip-text"/>
    </VBox>

    <VBox fx:id="reconnectingOverlay"
          visible="false"
          alignment="CENTER"
          spacing="20"
          style="-fx-background-color: rgba(0,0,0,0.65);">
        <Label text="Connessione al server persa"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label text="Riconnessione in corso..."
               style="-fx-font-size: 16px; -fx-text-fill: #cccccc;"/>
    </VBox>

    <VBox fx:id="gameAbortedOverlay"
          visible="false"
          alignment="CENTER"
          spacing="20"
          style="-fx-background-color: rgba(0,0,0,0.75);">
        <Label text="Game aborted"
               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label text="A player disconnected."
               style="-fx-font-size: 16px; -fx-text-fill: #cccccc;"/>
        <Label text="Closing..."
               style="-fx-font-size: 14px; -fx-text-fill: #aaaaaa;"/>
    </VBox>

</StackPane>