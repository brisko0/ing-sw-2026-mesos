<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="rootPane" prefHeight="576.0" prefWidth="1024.0"
           stylesheets="@../css/pre_lobby_style.css" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.ingsw.am56.view.GUI.controllers.PreLobbyController">

    <ImageView fitWidth="${rootPane.width}" fitHeight="${rootPane.height}" preserveRatio="false">
        <Image url="@../images/background_empty2.png" />
    </ImageView>

    <GridPane alignment="CENTER">
        <columnConstraints>
            <ColumnConstraints percentWidth="15"/>
            <ColumnConstraints percentWidth="30"/>
            <ColumnConstraints percentWidth="10"/>
            <ColumnConstraints percentWidth="30"/>
            <ColumnConstraints percentWidth="15"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints percentHeight="10"/>
            <RowConstraints percentHeight="80"/>
            <RowConstraints percentHeight="10"/>
        </rowConstraints>

        <GridPane fx:id="createBox" styleClass="create-panel" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <columnConstraints>
                <ColumnConstraints percentWidth="18"/>
                <ColumnConstraints percentWidth="64" halignment="CENTER"/>
                <ColumnConstraints percentWidth="18"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints percentHeight="35"/> <RowConstraints percentHeight="9"/>  <RowConstraints percentHeight="2"/>  <RowConstraints percentHeight="9"/>  <RowConstraints percentHeight="15"/> <RowConstraints percentHeight="10"/> <RowConstraints percentHeight="20"/> </rowConstraints>

            <TextField fx:id="gameSizeField" promptText="NUMERO GIOCATORI (2-4)" styleClass="mesos-input"
                       GridPane.columnIndex="1" GridPane.rowIndex="1" maxHeight="Infinity" maxWidth="Infinity"/>

            <TextField fx:id="createNicknameField" promptText="NICKNAME" styleClass="mesos-input"
                       GridPane.columnIndex="1" GridPane.rowIndex="3" maxHeight="Infinity" maxWidth="Infinity"/>

            <HBox spacing="25" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="4">
                <ImageView fitHeight="70" preserveRatio="true" styleClass="totem-choice" onMouseClicked="#selectColor" userData="BLACK">
                    <Image url="@../images/totem2D/black_2D.png"/></ImageView>
                <ImageView fitHeight="70" preserveRatio="true" styleClass="totem-choice" onMouseClicked="#selectColor" userData="CYAN">
                    <Image url="@../images/totem2D/cyan_2D.png"/></ImageView>
                <ImageView fitHeight="70" preserveRatio="true" styleClass="totem-choice" onMouseClicked="#selectColor" userData="RED">
                    <Image url="@../images/totem2D/red_2D.png"/></ImageView>
                <ImageView fitHeight="70" preserveRatio="true" styleClass="totem-choice" onMouseClicked="#selectColor" userData="WHITE">
                    <Image url="@../images/totem2D/white_2D.png"/></ImageView>
                <ImageView fitHeight="70" preserveRatio="true" styleClass="totem-choice" onMouseClicked="#selectColor" userData="YELLOW">
                    <Image url="@../images/totem2D/yellow_2D.png"/></ImageView>
            </HBox>

            <Button fx:id="createBtn" onAction="#handleCreateGame" styleClass="create-button"
                    GridPane.columnIndex="1" GridPane.rowIndex="5" />
        </GridPane>

        <GridPane fx:id="joinBox" styleClass="join-panel" GridPane.columnIndex="3" GridPane.rowIndex="1">
            <columnConstraints>
                <ColumnConstraints percentWidth="18"/>
                <ColumnConstraints percentWidth="64" halignment="CENTER"/>
                <ColumnConstraints percentWidth="18"/>
            </columnConstraints>

            <rowConstraints>
                <RowConstraints percentHeight="35"/> <RowConstraints percentHeight="5.5"/> <RowConstraints percentHeight="9"/>   <RowConstraints percentHeight="5.5"/> <RowConstraints percentHeight="15"/> <RowConstraints percentHeight="10"/> <RowConstraints percentHeight="20"/> </rowConstraints>

            <TextField fx:id="joinNicknameField" promptText="NICKNAME" styleClass="mesos-input"
                       GridPane.columnIndex="1" GridPane.rowIndex="2"
                       maxHeight="Infinity" maxWidth="Infinity"/>

            <HBox spacing="25" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="4">
                <ImageView fitHeight="70" preserveRatio="true" styleClass="totem-choice" onMouseClicked="#selectColor" userData="BLACK">
                    <Image url="@../images/totem2D/black_2D.png"/></ImageView>
                <ImageView fitHeight="70" preserveRatio="true" styleClass="totem-choice" onMouseClicked="#selectColor" userData="CYAN">
                    <Image url="@../images/totem2D/cyan_2D.png"/></ImageView>
                <ImageView fitHeight="70" preserveRatio="true" styleClass="totem-choice" onMouseClicked="#selectColor" userData="RED">
                    <Image url="@../images/totem2D/red_2D.png"/></ImageView>
                <ImageView fitHeight="70" preserveRatio="true" styleClass="totem-choice" onMouseClicked="#selectColor" userData="WHITE">
                    <Image url="@../images/totem2D/white_2D.png"/></ImageView>
                <ImageView fitHeight="70" preserveRatio="true" styleClass="totem-choice" onMouseClicked="#selectColor" userData="YELLOW">
                    <Image url="@../images/totem2D/yellow_2D.png"/></ImageView>
            </HBox>

            <Button fx:id="joinBtn" onAction="#handleJoinGame" styleClass="join-button"
                    GridPane.columnIndex="1" GridPane.rowIndex="5" />
        </GridPane>
    </GridPane>
</StackPane>