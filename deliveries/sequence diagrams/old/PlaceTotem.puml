@startuml
autonumber
skinparam style strictuml
skinparam sequenceMessageAlign center
skinparam maxMessageSize 150

actor "User\n(Active Player)" as User
participant "ClientApp\n(View)" as Client
participant "VirtualView\n(Client Proxy)" as Callback
participant "VirtualServer\n(Server Proxy)" as Server
participant "GameController" as Controller
participant "GameModel" as Model
participant "ClientHandler\n(Observer)" as Handler

== Phase 4: Totem Placement ==
User -> Client: Selects Offer Tile (e.g., 'C')\nClicks "Place Totem"

alt Valid Move (Success)

    Client -> Server: moveTotem(TotemMoveRequest("Alice", "C"))
    activate Server
    Server -> Controller: moveTotem(request)
    activate Controller

    ' 1. Execution of the move
    Controller -> Model: handleTotemPlacement(player, tile)
    activate Model

    Model -> Handler: onModelChanged(TOTEM_PLACED)
    activate Handler
    Handler ->> Callback: showUpdate(TotemPlacedMessage)
    activate Callback
    Callback -> Callback: executeOnClient(this)
    Callback --> User: Renders totem on Tile 'C'
    deactivate Callback
    deactivate Handler

    Model --> Controller: return
    deactivate Model

    ' 2. Updating the turn order
    Controller -> Model: setCurrentPlayerOrder()
    activate Model

    Model -> Handler: onModelChanged(TURN_CHANGED)
    activate Handler
    Handler ->> Callback: showUpdate(TurnChangedMessage)
    activate Callback
    Callback -> Callback: executeOnClient(this)
    deactivate Callback
    deactivate Handler

    ' 3. Checking if the phase is over
    opt All Totems Placed
        note over Model: If all players have placed their totems,\nthe game transitions to CardPicking.
        Model -> Model: setState(new CardPicking(this))

        Model -> Handler: onModelChanged(STATE_CHANGED)
        activate Handler
        Handler ->> Callback: showUpdate(StateChangedMessage)
        activate Callback
        Callback -> Callback: executeOnClient(this)
        deactivate Callback
        deactivate Handler
    end

    Model --> Controller: return
    deactivate Model

    Controller --> Server: return
    deactivate Controller
    Server --> Client: return
    deactivate Server

else Exception Thrown (Rule Violation)

    note over Client, Model: Example: "Alice" tries to move when it's "Bob's" turn,\nor Tile 'C' is already occupied.

    Client -> Server: moveTotem(request)
    activate Server
    Server -> Controller: moveTotem(request)
    activate Controller

    Controller -> Model: validate turn & tile availability
    activate Model

    Model --> Controller: throws InvalidActionException
    deactivate Model

    Controller --> Server: throws InvalidActionException
    deactivate Controller

    Server --> Client: throws Exception
    deactivate Server

    Client -> Client: catch(Exception e)
    User <-- Client: Displays Error Popup\n"Not your turn!" or "Tile Occupied!"

end

@enduml