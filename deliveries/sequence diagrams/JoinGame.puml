@startuml
autonumber
skinparam style strictuml
skinparam sequenceMessageAlign center
skinparam maxMessageSize 150

actor "User\n(Joining Player)" as User
participant "ClientApp\n(View)" as Client
participant "VirtualView\n(Client Proxy)" as Callback
participant "VirtualServer\n(Server Proxy)" as Server
participant "GameController" as Controller
participant "GameModel" as Model
participant "ClientHandler\n(Observer)" as Handler

== Phase 3: Player Join & State Transition ==
User -> Client: Enters Nickname & Color\nClicks "Join Game"

alt Valid Join Request (Success)

    Client -> Server: addPlayer("Bob", "BLUE")
    activate Server
    Server -> Controller: addPlayer("Bob", "BLUE")
    activate Controller

    Controller -> Model: addPlayer(new Player("Bob", "BLUE"))
    activate Model

    ' 1. Standard Player Added Notification
    Model -> Handler: onModelChanged(PLAYER_ADDED)
    activate Handler
    Handler ->> Callback: showUpdate(PlayerAddedMessage)
    activate Callback
    Callback -> Callback: executeOnClient(this)
    deactivate Callback
    deactivate Handler

    ' 2. The Check inside PlayersFilling state
    opt Room is Full (players.size() == gameSize)
        note over Model: PlayersFilling state detects room is full.\nAutomatically transitions to next phase.

        Model -> Model: setState(new TotemPlacement(this))

        ' State Change Notification
        Model -> Handler: onModelChanged(STATE_CHANGED)
        activate Handler
        Handler ->> Callback: showUpdate(StateChangedMessage)
        activate Callback
        Callback -> Callback: executeOnClient(this)
        deactivate Callback
        deactivate Handler

        ' Turn Notification for the first player
        Model -> Handler: onModelChanged(TURN_CHANGED)
        activate Handler
        Handler ->> Callback: showUpdate(TurnChangedMessage)
        activate Callback
        Callback -> Callback: executeOnClient(this)
        deactivate Callback
        deactivate Handler
    end

    Model --> Controller: return
    deactivate Model
    Controller --> Server: return
    deactivate Controller
    Server --> Client: return
    deactivate Server

    User <-- Client: Shows updated Lobby or Game Board

else Exception Thrown (e.g., Nickname Taken / Room Full)

    note over Client, Model: Example: "Bob" is already taken or the game has already started

    Client -> Server: addPlayer("Bob", "BLUE")
    activate Server
    Server -> Controller: addPlayer("Bob", "BLUE")
    activate Controller
    Controller -> Model: validate request
    activate Model

    Model --> Controller: throws InvalidActionException
    deactivate Model

    Controller --> Server: throws InvalidActionException
    deactivate Controller

    Server --> Client: throws Exception
    deactivate Server

    Client -> Client: catch(Exception e)
    User <-- Client: Displays Error Popup\n"Nickname already in use!"

end

@enduml